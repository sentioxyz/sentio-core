{
  "name": "@sentio/chain",
  "version": "3.4.36",
  "description": "Chain utils",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sentioxyz/sentio-core.git",
    "directory": "packages/chain"
  },
  "main": "./dist/index.js",
  "files": [
    "dist",
    "src",
    "!**/*.test.js",
    "!**/*.test.ts",
    "!dist/codegen",
    "!dist/tests",
    "!src/codegen",
    "!src/tests"
  ],
  "scripts": {
    "build": "tsc -p . && pnpm generate",
    "generate": "tsx src/codegen/generate-go.ts",
    "preinstall": "npx only-allow pnpm",
    "lint": "eslint .",
    "package": "pnpm build",
    "pub": "pnpm test && pnpm package && pnpm clean-publish --fields scripts --package-manager pnpm -- --no-git-checks ",
    "prepublishOnly": "pnpm package",
    "test": "glob -c 'tsx --test' '**/*.test.ts'"
  },
  "types": "./dist/index.d.ts",
  "devDependencies": {
    "@types/lodash": "^4.17.6",
    "@types/node": "^24.0.0",
    "clean-publish": "^5.0.0",
    "lodash": "^4.17.21"
  }
}
